
(rules PCB companion-board.dsn
  (snapAngle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (viaRule
    default "Via[0-3]_600:300_um"
  )
  (viaRule
    default "Via[0-3]_600:300_um"
  )
  (class default
    GND "LINE_IN_R" "LINE_IN_L" "I^{2}S_BCLK" "Net-(U1-WCLK)" +3.3V "SD_DETECT" "SD_CMD"
    "I^{2}S_SPK_DATA" "Net-(U1-DIN{slash}MFP1)" "Button_1" "Button_PTT" "I^{2}C_SCL" "Net-(U1-REF)" "SD_DAT2" "Net-(U1-IN2_L)"
    "LED_Red" "Net-(D1-Pad2)" "Net-(U1-MICBIAS)" MIC "SD_DAT1" +5V "unconnected-(J2-Pin_3-Pad3)" "unconnected-(J2-Pin_4-Pad4)"
    "unconnected-(J2-Pin_5-Pad5)" "unconnected-(J2-Pin_6-Pad6)" "unconnected-(J2-Pin_7-Pad7)" "unconnected-(J2-Pin_8-Pad8)" "unconnected-(J2-Pin_9-Pad9)" "unconnected-(J2-Pin_10-Pad10)" "I^{2}S_MIC_DATA" "CODEC_RESET"
    "SD_DAT3" "unconnected-(J2-Pin_16-Pad16)" "Button_2" "LED_Green" "Net-(D4-Pad2)" "Net-(X1-OUT)" "Net-(U1-HPL)" "HS_Left"
    "Net-(U1-IN3_L)" "Net-(JP3-A)" "I^{2}C_SDA" "SD_DAT0" "SD_CLK" "Net-(U1-DOUT{slash}MFP2)" "unconnected-(J1-Pin_4-Pad4)" "unconnected-(J1-Pin_12-Pad12)"
    "I^{2}S_WCLK" "unconnected-(J1-Pin_14-Pad14)" "Net-(U1-IN1_L)" "Net-(U1-IN1_R)" "Net-(JP2-A)" "Net-(U1-DVDD)" "I^{2}S_MCLK" "Net-(U1-IN2_R)"
    "Net-(U1-AVDD)" "Line_Out_Right" "Line_Out_Left" "Net-(U1-BCLK)" "Net-(JP1-B)" "Net-(U1-MISO{slash}MFP4)" "Net-(U1-IN3_R)" "Net-(U1-HPR)"
    "Net-(U1-GPIO{slash}MFP5)" "HS_Right" "Net-(TP2-Pad1)" "Net-(TP1-Pad1)" "Net-(JP5-B)" "Net-(JP4-A)" "unconnected-(S3-NO_2-Pad4)" "unconnected-(S3-COM_2-Pad5)"
    "unconnected-(S3-NC_2-Pad6)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
)