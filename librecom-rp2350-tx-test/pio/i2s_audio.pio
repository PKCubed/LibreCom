.program i2s_tx
.side_set 2

.wrap_target
    pull block         side 0b00
    set x, 31          side 0b00
left_bits:
    out pins, 1        side 0b00
    jmp x-- left_bits  side 0b10
    pull block         side 0b01
    set x, 31          side 0b01
right_bits:
    out pins, 1        side 0b01
    jmp x-- right_bits side 0b11
.wrap

.program i2s_rx
.side_set 2

.wrap_target
    set x, 31          side 0b00
left_bits:
    in pins, 1         side 0b10
    jmp x-- left_bits  side 0b00
    set x, 31          side 0b01
right_bits:
    in pins, 1         side 0b11
    jmp x-- right_bits side 0b01
.wrap