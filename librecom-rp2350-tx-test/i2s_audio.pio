; Shared PIO programs for RP2350 Codec2 audio link.
; Pin mapping assumed by C code:
;   DATA pin = GPIO 8
;   LRCK pin = GPIO 9
;   BCK pin  = GPIO 10
;   MCLK pin = GPIO 11 (TX board only)

.program bck_out
.side_set 1
.wrap_target
    nop         side 1
    nop         side 0
.wrap

.program mclk_out
.side_set 1
.wrap_target
    nop         side 1
    nop         side 0
.wrap

.program lrck_from_bck
; wait pin base must point to BCK pin.
; set pin base must point to LRCK pin.
.wrap_target
    set pins, 0
    set x, 31
low_loop:
    wait 1 pin 0
    wait 0 pin 0
    jmp x-- low_loop

    set pins, 1
    set x, 31
high_loop:
    wait 1 pin 0
    wait 0 pin 0
    jmp x-- high_loop
.wrap

.program i2s_rx_data
; wait pin base must point to DATA pin so BCK is pin index +2.
; in pin base must point to DATA pin.
.wrap_target
    wait 0 pin 2
    wait 1 pin 2
    in pins, 1
.wrap

.program i2s_tx_data
; wait pin base must point to DATA pin so LRCK is pin index +1 and BCK is pin index +2.
; out pin base must point to DATA pin.
.wrap_target
    wait 0 pin 1
    set x, 31
left_word:
    wait 0 pin 2
    out pins, 1
    wait 1 pin 2
    jmp x-- left_word

    wait 1 pin 1
    set x, 31
right_word:
    wait 0 pin 2
    out pins, 1
    wait 1 pin 2
    jmp x-- right_word
.wrap
