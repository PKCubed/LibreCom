.program i2s_slave_rx

; Updated to match the RP2040-Zero available pins
.define BCK 1
.define LRCK 2

.wrap_target
    ; Wait for Left Channel (LRCK goes low)
    wait 0 gpio LRCK
    
    ; Standard I2S has a 1-clock delay before the MSB is transmitted
    wait 0 gpio BCK
    wait 1 gpio BCK
    
    set x, 31          ; We read 32 bits per channel
left_read:
    wait 0 gpio BCK    ; Wait for PCM1808 to put bit on DOUT
    wait 1 gpio BCK    ; Read bit on rising edge
    in pins, 1         ; Shift DOUT into our register
    jmp x-- left_read
    
    ; Wait for Right Channel (LRCK goes high)
    wait 1 gpio LRCK
    
    ; 1-clock delay
    wait 0 gpio BCK
    wait 1 gpio BCK
    
    set x, 31
right_read:
    wait 0 gpio BCK
    wait 1 gpio BCK
    in pins, 1         ; Shift DOUT into our register
    jmp x-- right_read
.wrap