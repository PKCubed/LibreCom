.program i2s_tx
.side_set 2

; Side-set bits:
; 0b00 = LCK Low,  BCK Low
; 0b01 = LCK Low,  BCK High
; 0b10 = LCK High, BCK Low
; 0b11 = LCK High, BCK High

.wrap_target
    ; Transition from Right to Left Channel
    pull noblock       side 0b10 
    set x, 30          side 0b11 
left_data:
    out pins, 1        side 0b00 ; LCK goes Low, BCK goes Low (Shift MSB)
    jmp x-- left_data  side 0b01 ; LCK stays Low, BCK goes High (DAC reads bit)
    out pins, 1        side 0b00 
    
    ; Transition from Left to Right Channel
    pull noblock       side 0b00 
    set x, 30          side 0b01 
right_data:
    out pins, 1        side 0b10 ; LCK goes High, BCK goes Low (Shift MSB)
    jmp x-- right_data side 0b11 ; LCK stays High, BCK goes High (DAC reads bit)
    out pins, 1        side 0b10 
.wrap