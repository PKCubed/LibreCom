.program i2s_dac_out
.side_set 2

.wrap_target
    pull noblock      side 0b10
    set x, 30         side 0b11
left_loop:
    out pins, 1       side 0b00
    jmp x-- left_loop side 0b01
    out pins, 1       side 0b00

    pull noblock      side 0b00
    set x, 30         side 0b01
right_loop:
    out pins, 1       side 0b10
    jmp x-- right_loop side 0b11
    out pins, 1       side 0b10
.wrap
