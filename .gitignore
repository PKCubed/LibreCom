# ESP-IDF build output. Fully regenerated by idf.py build.
build/

# Transient artifact left behind when idf.py rewrites sdkconfig.
sdkconfig.old

# Pulled in by the IDF component manager, not authored here.
managed_components/
dependencies.lock

# Editor scratch
.vscode/ipch/

# Generated by compression-alg-tests/compress_audio.py. The script is tracked;
# its ~11 MB of derived audio is not.
compression-alg-tests/compressed/
compression-alg-tests/compressed.zip

# Source audio for the codec comparison. Deliberately not versioned: music1.flac
# alone is 77 MB and git keeps blobs forever, and the material may not be ours
# to redistribute. The script that consumes them is tracked; drop your own files
# in alongside it.
compression-alg-tests/*.flac
compression-alg-tests/*.aac
compression-alg-tests/*.wav
