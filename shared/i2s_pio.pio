.program audio_i2s_tx
.side_set 2

; 32-bit stereo standard I2S (64 fs)
; BCK (GP10) is bit 1
; LRCK (GP9) is bit 0
; Data changes on falling edge (BCK=0)

public entry_point:
    set x, 30       side 0b10 ; Initial state: BCK=1, LRCK=0
left_loop:
    out pins, 1     side 0b00 ; BCK=0, LRCK=0 (falling edge)
    jmp x-- left_loop side 0b10 ; BCK=1, LRCK=0 (rising edge)

    out pins, 1     side 0b01 ; BCK=0, LRCK=1 (LRCK transitions to Right)
    set x, 30       side 0b11 ; BCK=1, LRCK=1

right_loop:
    out pins, 1     side 0b01 ; BCK=0, LRCK=1 (falling edge)
    jmp x-- right_loop side 0b11 ; BCK=1, LRCK=1 (rising edge)

    out pins, 1     side 0b00 ; BCK=0, LRCK=0 (LRCK transitions to Left)
    set x, 30       side 0b10 ; BCK=1, LRCK=0


.program audio_i2s_rx
.side_set 2

; 32-bit stereo standard I2S (64 fs)
; BCK (GP10) is bit 1
; LRCK (GP9) is bit 0
; Sample data on rising edge (BCK=1)

public entry_point_rx:
    set x, 30       side 0b00 ; Initial state: BCK=0, LRCK=0
left_loop_rx:
    in pins, 1      side 0b10 ; BCK=1, LRCK=0 (rising edge, sample data)
    jmp x-- left_loop_rx side 0b00 ; BCK=0, LRCK=0 (falling edge)

    in pins, 1      side 0b10 ; BCK=1, LRCK=0 (rising edge, sample LSB)
    set x, 30       side 0b01 ; BCK=0, LRCK=1 (falling edge, LRCK transitions to Right)

right_loop_rx:
    in pins, 1      side 0b11 ; BCK=1, LRCK=1 (rising edge, sample data)
    jmp x-- right_loop_rx side 0b01 ; BCK=0, LRCK=1 (falling edge)

    in pins, 1      side 0b11 ; BCK=1, LRCK=1 (rising edge, sample LSB)
    set x, 30       side 0b00 ; BCK=0, LRCK=0 (falling edge, LRCK transitions to Left)


% c-sdk {

static inline void audio_i2s_tx_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_pin_base) {
    pio_sm_config sm_config = audio_i2s_tx_program_get_default_config(offset);
    
    sm_config_set_out_pins(&sm_config, data_pin, 1);
    sm_config_set_sideset_pins(&sm_config, clock_pin_base);
    sm_config_set_out_shift(&sm_config, false, true, 32); // Shift left, autopull, 32 bits
    sm_config_set_clkdiv(&sm_config, 148.0f);
    
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin_base);     // LRCK
    pio_gpio_init(pio, clock_pin_base + 1); // BCK
    
    pio_sm_set_pindirs_with_mask(pio, sm, 
        (1u << data_pin) | (3u << clock_pin_base), 
        (1u << data_pin) | (3u << clock_pin_base));
        
    pio_sm_init(pio, sm, offset + audio_i2s_tx_offset_entry_point, &sm_config);
    
    // We execute a set instruction to set the initial pin state
    pio_sm_exec(pio, sm, pio_encode_set(pio_pins, 0));
}

static inline void audio_i2s_rx_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_pin_base) {
    pio_sm_config sm_config = audio_i2s_rx_program_get_default_config(offset);
    
    sm_config_set_in_pins(&sm_config, data_pin);
    sm_config_set_sideset_pins(&sm_config, clock_pin_base);
    sm_config_set_in_shift(&sm_config, false, true, 32); // Shift left, autopush, 32 bits
    sm_config_set_clkdiv(&sm_config, 148.0f);
    
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin_base);     // LRCK
    pio_gpio_init(pio, clock_pin_base + 1); // BCK
    
    pio_sm_set_pindirs_with_mask(pio, sm, 
        (3u << clock_pin_base), 
        (1u << data_pin) | (3u << clock_pin_base));
        
    pio_sm_init(pio, sm, offset + audio_i2s_rx_offset_entry_point_rx, &sm_config);
    
    pio_sm_exec(pio, sm, pio_encode_set(pio_pins, 0));
}

%}
